<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:u="https://irihi.tech/ursa">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    <Setter Property="Background" Value="{DynamicResource ManituxPageBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextBrush}" />
  </Style>

  <Style Selector="UserControl">
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextBrush}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextMutedBrush}" />
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextSubtleBrush}" />
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="40" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LineHeight" Value="30" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextSubtleBrush}" />
  </Style>

  <Style Selector="Border.manitux-glass">
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxGlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusLarge}" />
    <Setter Property="BoxShadow" Value="0 18 52 0 #66000000" />
  </Style>

  <Style Selector="Border.manitux-panel">
    <Setter Property="Background" Value="{DynamicResource ManituxChromeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusMedium}" />
  </Style>

  <Style Selector="Border.manitux-card">
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusSmall}" />
  </Style>

  <Style Selector="Border.player-osd">
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxGlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BoxShadow" Value="0 18 44 0 #88000000" />
  </Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="{DynamicResource ManituxRemoteTargetMin}" />
    <Setter Property="MinWidth" Value="{DynamicResource ManituxRemoteTargetMin}" />
    <Setter Property="Padding" Value="{DynamicResource ManituxControlPadding}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextBrush}" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentBrush}" />
  </Style>

  <Style Selector="Button:focus">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
    <Setter Property="ZIndex" Value="5" />
  </Style>

  <Style Selector="Button:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 7 #882D9CFF" />
  </Style>

  <Style Selector="Button:focus-visible">
    <Setter Property="RenderTransform" Value="scale(1.03)" />
    <Setter Property="ZIndex" Value="5" />
  </Style>

  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 7 #882D9CFF" />
  </Style>

  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)" />
    <Setter Property="ZIndex" Value="6" />
  </Style>

  <Style Selector="Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#552D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 7 #882D9CFF" />
  </Style>

  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource ManituxAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentBrush}" />
  </Style>

  <Style Selector="Button.warm">
    <Setter Property="Background" Value="{DynamicResource ManituxAccentWarmBrush}" />
    <Setter Property="Foreground" Value="#FF171511" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentWarmBrush}" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="#332D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>

  <Style Selector="Button.nav:focus-visible">
    <Setter Property="RenderTransform" Value="scale(1.02)" />
  </Style>

  <Style Selector="Button.nav:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="#442D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 6 #662D9CFF" />
  </Style>

  <Style Selector="Button.nav:focus-visible /template/ ContentPresenter">
    <Setter Property="Background" Value="#442D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 6 #662D9CFF" />
  </Style>

  <Style Selector="Button.nav:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#552D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 6 #662D9CFF" />
  </Style>

  <Style Selector="Button.rail">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="MinWidth" Value="56" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.rail.selected">
    <Setter Property="Background" Value="#332D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentBrush}" />
  </Style>

  <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#22FFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentBrush}" />
  </Style>

  <Style Selector="Button.rail:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="#442D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 6 #662D9CFF" />
  </Style>

  <Style Selector="Button.rail:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#552D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 6 #662D9CFF" />
  </Style>

  <Style Selector="Button.mobile-nav">
    <Setter Property="MinWidth" Value="68" />
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.mobile-nav.selected">
    <Setter Property="Background" Value="#332D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentBrush}" />
  </Style>

  <Style Selector="Button.mobile-nav:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="#442D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 6 #662D9CFF" />
  </Style>

  <Style Selector="Button.mobile-nav:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#552D9CFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 6 #662D9CFF" />
  </Style>

  <Style Selector="materialIcons|MaterialIcon.nav-icon">
    <Setter Property="Width" Value="25" />
    <Setter Property="Height" Value="25" />
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextMutedBrush}" />
  </Style>

  <Style Selector="Button.selected materialIcons|MaterialIcon.nav-icon">
    <Setter Property="Foreground" Value="{DynamicResource ManituxAccentBrush}" />
  </Style>

  <Style Selector="Button.poster">
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusMedium}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.poster /template/ ContentPresenter">
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusMedium}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.poster Border.poster-content">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <Style Selector="Button.poster:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04)" />
    <Setter Property="ZIndex" Value="10" />
  </Style>

  <Style Selector="Button.poster:pointerover /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 12 36 0 #aa000000" />
  </Style>

  <Style Selector="Button.poster:focus">
    <Setter Property="RenderTransform" Value="scale(1.06)" />
    <Setter Property="ZIndex" Value="10" />
  </Style>

  <Style Selector="Button.poster:focus /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 16 48 8 #aa2D9CFF" />
  </Style>

  <Style Selector="Button.poster:focus-visible">
    <Setter Property="RenderTransform" Value="scale(1.06)" />
    <Setter Property="ZIndex" Value="10" />
  </Style>

  <Style Selector="Button.poster:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 16 48 8 #aa2D9CFF" />
  </Style>

  <Style Selector="Button.poster:pressed">
    <Setter Property="RenderTransform" Value="scale(1.02)" />
    <Setter Property="ZIndex" Value="11" />
  </Style>

  <Style Selector="Button.poster:pressed /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 14 42 6 #aa2D9CFF" />
  </Style>

  <Style Selector="Button.osd">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxBorderBrush}" />
  </Style>

  <Style Selector="Button.osd.primary">
    <Setter Property="Width" Value="62" />
    <Setter Property="Height" Value="62" />
    <Setter Property="MinWidth" Value="62" />
    <Setter Property="MinHeight" Value="62" />
    <Setter Property="CornerRadius" Value="31" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Background" Value="{DynamicResource ManituxAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.osd.compact">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="46" />
    <Setter Property="MinWidth" Value="46" />
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="CornerRadius" Value="23" />
    <Setter Property="FontSize" Value="15" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource ManituxRemoteTargetMin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusSmall}" />
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextBrush}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource ManituxChromeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ManituxTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxGlassStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ProgressBar:focus">
    <Setter Property="Height" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource ManituxAccentBrush}" />
  </Style>

  <Style Selector="ProgressBar.seek-active">
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource ManituxAccentWarmBrush}" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource ManituxRemoteTargetMin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusSmall}" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}" />
  </Style>

  <Style Selector="ListBoxItem:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}" />
    <Setter Property="BorderThickness" Value="3" />
  </Style>

  <Style Selector="u|NavMenuItem">
    <Setter Property="MinHeight" Value="{DynamicResource ManituxRemoteTargetMin}" />
  </Style>
</Styles>
