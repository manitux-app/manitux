<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.1</Version>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <RepositoryUrl>https://github.com/manitux-app/manitux</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Manitux\Assets\icons\Manitux.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="favicon.ico" />
    <Content Include="..\Manitux\Assets\icons\Manitux.ico">
      <Link>icons\Manitux.ico</Link>
    </Content>
    <Content Include="..\Manitux\Assets\icons\Manitux.icns">
      <Link>icons\Manitux.icns</Link>
    </Content>
    <None Include="data\app\players.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="data\app\players.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Manitux\Manitux.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="helpers\osx-arm64\" />
    <Folder Include="helpers\osx-x64\" />
    <Folder Include="helpers\win-x64\" />
    <Folder Include="runtimes\linux-x64\native\" />
	  <Folder Include="runtimes\linux-arm64\native\" />
    <Folder Include="runtimes\osx-x64\native\" />
	  <Folder Include="runtimes\osx-arm64\native\" />
    <Folder Include="runtimes\win-x64\native\" />
  </ItemGroup>

<ItemGroup>
  <!-- Windows x64 -->
  <Content Include="runtimes\win-x64\native\*.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows))))">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    <TargetPath>libs\%(Filename)%(Extension)</TargetPath>
    <PublishState>Included</PublishState>
  </Content>

  <!-- Linux x64 -->
  <Content Include="runtimes\linux-x64\native\*.so*" Condition="'$(RuntimeIdentifier)' == 'linux-x64' or ('$(RuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux))))">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    <TargetPath>libs\%(Filename)%(Extension)</TargetPath>
    <PublishState>Included</PublishState>
  </Content>
	
  <!-- macOS x64  -->
  <Content Include="runtimes\osx-x64\native\*.dylib" Condition="'$(RuntimeIdentifier)' == 'osx-x64' or ('$(RuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX))))">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    <TargetPath>libs\%(Filename)%(Extension)</TargetPath>
    <PublishState>Included</PublishState>
  </Content>

  <!-- macOS arm64  -->
  <Content Include="runtimes\osx-arm64\native\*.dylib" Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    <TargetPath>libs\%(Filename)%(Extension)</TargetPath>
    <PublishState>Included</PublishState>
  </Content>
</ItemGroup>

  <ItemGroup>
    <!-- Windows x64 helpers -->
    <None Include="helpers\win-x64\*" Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows))))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>libs\helpers\%(Filename)%(Extension)</Link>
      <TargetPath>libs\helpers\%(Filename)%(Extension)</TargetPath>
    </None>

    <!-- Linux x64 helpers -->
    <None Include="helpers\linux-x64\*" Condition="'$(RuntimeIdentifier)' == 'linux-x64' or ('$(RuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux))))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>libs\helpers\%(Filename)%(Extension)</Link>
      <TargetPath>libs\helpers\%(Filename)%(Extension)</TargetPath>
    </None>

    <!-- macOS x64 helpers -->
    <None Include="helpers\osx-x64\*" Condition="'$(RuntimeIdentifier)' == 'osx-x64' or ('$(RuntimeIdentifier)' == '' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX))))">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>libs\helpers\%(Filename)%(Extension)</Link>
      <TargetPath>libs\helpers\%(Filename)%(Extension)</TargetPath>
    </None>

    <!-- macOS arm64 helpers -->
    <None Include="helpers\osx-arm64\*" Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>libs\helpers\%(Filename)%(Extension)</Link>
      <TargetPath>libs\helpers\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

<Target Name="MakeHelperExecutable" AfterTargets="Publish">
  <Exec Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux))) and Exists('$(PublishDir)libs/helpers/tlsclientapi')" Command="chmod +x $(PublishDir)libs\helpers\tlsclientapi" />
  <Exec Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux))) and Exists('$(PublishDir)libs/helpers/ytdlp')" Command="chmod +x $(PublishDir)libs\helpers\ytdlp" />
  <!--<Exec Condition="$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))" 
        Command="chmod +x $(PublishDir)tlsclientapi" />-->
</Target>
</Project>
