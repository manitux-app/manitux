<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:u="https://irihi.tech/ursa"
					xmlns:local="using:Manitux.Player"
					xmlns:models="using:Manitux.Core.Models"
					xmlns:converter="using:Manitux.Converters"
					xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
					xmlns:mpv="using:LibMPVSharp.Avalonia">
  <!-- Add Resources Here -->
	<Design.PreviewWith>
		<Border Padding="20">
			<Border Background="Black">
				<local:MediaPlayerView Width="800" Height="400"/>
			</Border>
		</Border>
	</Design.PreviewWith>

	<ControlTheme TargetType="local:MediaPlayerView" x:Key="{x:Type local:MediaPlayerView}">
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="FocusAdorner" Value="{x:Null}"/>
		<Setter Property="Template">
			<ControlTemplate TargetType="local:MediaPlayerView">
				<Grid RowDefinitions="auto,*,auto">
					<Grid.Styles>
						<Style Selector="Slider.remote-active /template/ Thumb#PART_Thumb">
							<Setter Property="Background" Value="Orange"/>
							<Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusInnerBrush}"/>
						</Style>
						<Style Selector="Slider.remote-active">
							<Setter Property="Foreground" Value="Orange"/>
						</Style>
						<Style Selector="Slider.volume-slider /template/ Thumb#PART_Thumb">
							<Setter Property="Background" Value="{DynamicResource ManituxAccentBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusInnerBrush}"/>
						</Style>
						<Style Selector="Button.player-menu-item">
							<Setter Property="MinHeight" Value="56"/>
							<Setter Property="Padding" Value="12,8"/>
							<Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusSmall}"/>
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="BorderBrush" Value="Transparent"/>
							<Setter Property="BorderThickness" Value="1"/>
							<Setter Property="Foreground" Value="{DynamicResource ManituxTextBrush}"/>
							<Setter Property="FocusAdorner" Value="{x:Null}"/>
						</Style>
						<Style Selector="Button.player-menu-item:pointerover /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource ManituxSurfaceMutedBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentBrush}"/>
						</Style>
						<Style Selector="Button.player-menu-item:focus /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}"/>
							<Setter Property="BorderThickness" Value="3"/>
							<Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 7 #882D9CFF"/>
						</Style>
						<Style Selector="Button.player-menu-item:focus-visible /template/ ContentPresenter">
							<Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}"/>
							<Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}"/>
							<Setter Property="BorderThickness" Value="3"/>
							<Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 7 #882D9CFF"/>
						</Style>
					</Grid.Styles>
						
					<mpv:VideoView Grid.RowSpan="3"
					               MediaPlayer="{TemplateBinding MediaPlayer}"/>

					<Panel Grid.RowSpan="3"
					       Background="Transparent"/>

					<Border Grid.RowSpan="3"
							x:Name="PART_AudioPanel"
							IsVisible="{TemplateBinding IsAudioPanelVisible}"
							HorizontalAlignment="Right"
							VerticalAlignment="Bottom"
							Margin="0,0,24,104"
							Width="320"
							MaxHeight="360"
							CornerRadius="{DynamicResource ManituxRadiusMedium}"
							Background="{DynamicResource ManituxSurfaceBrush}"
							BorderBrush="{DynamicResource ManituxGlassStrokeBrush}"
							BorderThickness="1"
							BoxShadow="0 18 44 0 #88000000"
							Padding="12">
						<ScrollViewer MaxHeight="336"
									  VerticalScrollBarVisibility="Auto">
							<ItemsControl ItemsSource="{TemplateBinding AudioTracks}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:AudioTrackModel">
										<Button Classes="player-menu-item audio-panel-item"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Stretch"
												Command="{x:Static local:MediaPlayerView.AudioTrackCmd}"
												CommandParameter="{Binding Id}">
											<Grid ColumnDefinitions="32,*" ColumnSpacing="10">
												<materialIcons:MaterialIcon Grid.Column="0"
																			Kind="MusicNote"
																			Width="24"
																			Height="24"
																			Foreground="{DynamicResource ManituxTextMutedBrush}"
																			VerticalAlignment="Center"/>
												<StackPanel Grid.Column="1"
															Orientation="Vertical"
															VerticalAlignment="Center"
															Spacing="2">
													<TextBlock Text="{Binding Name}"
															   Foreground="{DynamicResource ManituxTextBrush}"
															   FontSize="18"
															   FontWeight="SemiBold"
															   TextTrimming="CharacterEllipsis"/>
													<TextBlock Text="{Binding Language}"
															   Foreground="{DynamicResource ManituxTextMutedBrush}"
															   FontSize="13"
															   TextTrimming="CharacterEllipsis"/>
												</StackPanel>
											</Grid>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Border>

					<Border Grid.RowSpan="3"
							x:Name="PART_SubtitlePanel"
							IsVisible="{TemplateBinding IsSubtitlePanelVisible}"
							HorizontalAlignment="Right"
							VerticalAlignment="Bottom"
							Margin="0,0,24,104"
							Width="320"
							MaxHeight="360"
							CornerRadius="{DynamicResource ManituxRadiusMedium}"
							Background="{DynamicResource ManituxSurfaceBrush}"
							BorderBrush="{DynamicResource ManituxGlassStrokeBrush}"
							BorderThickness="1"
							BoxShadow="0 18 44 0 #88000000"
							Padding="12">
						<ScrollViewer MaxHeight="336"
									  VerticalScrollBarVisibility="Auto">
							<ItemsControl ItemsSource="{TemplateBinding SubTitles}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="models:SubtitleModel">
										<Button Classes="player-menu-item subtitle-panel-item"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Stretch"
												Command="{x:Static local:MediaPlayerView.SubTitleCmd}"
												CommandParameter="{Binding Id}">
											<Grid ColumnDefinitions="32,*" ColumnSpacing="10">
												<materialIcons:MaterialIcon Grid.Column="0"
																			Kind="ClosedCaption"
																			Width="24"
																			Height="24"
																			Foreground="{DynamicResource ManituxTextMutedBrush}"
																			VerticalAlignment="Center"/>
												<StackPanel Grid.Column="1"
															Orientation="Vertical"
															VerticalAlignment="Center"
															Spacing="2">
													<TextBlock Text="{Binding Name}"
															   Foreground="{DynamicResource ManituxTextBrush}"
															   FontSize="18"
															   FontWeight="SemiBold"
															   TextTrimming="CharacterEllipsis"/>
													<TextBlock Text="{Binding Id}"
															   Foreground="{DynamicResource ManituxTextMutedBrush}"
															   FontSize="13"
															   TextTrimming="CharacterEllipsis"/>
												</StackPanel>
											</Grid>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Border>

					<Border Grid.Row="2"
							x:Name="PART_ControlBar"
							Classes="player-osd"
							IsVisible="{TemplateBinding AreControlsVisible}"
							Margin="16,0,16,18"
							Padding="12,8"
							Height="76">
						<DockPanel LastChildFill="True">
							<!-- play -->
							<Button Theme="{StaticResource IconButton}"
									DockPanel.Dock="Left"
									VerticalAlignment="Center"
									Margin="8,0,4,0"
									Command="{x:Static local:MediaPlayerView.PlayPauseCmd}"
									x:Name="playpause_button">
								<Grid>
									<materialIcons:MaterialIcon x:Name="play_icon" Kind="Play" Width="26" Height="26"/>
									<materialIcons:MaterialIcon x:Name="pause_icon" Kind="Pause" Width="26" Height="26" IsVisible="False"/>
								</Grid>
							</Button>

							<Button Theme="{StaticResource IconButton}"
									DockPanel.Dock="Left"
									VerticalAlignment="Center"
									Margin="0,0,8,0"
									Foreground="{DynamicResource ManituxDangerBrush}"
									Command="{x:Static local:MediaPlayerView.StopCmd}">
								<materialIcons:MaterialIcon Kind="Stop" Width="26" Height="26"/>
							</Button>

							<StackPanel Orientation="Horizontal"
										DockPanel.Dock="Right"
										Margin="4,0,8,0"
										Spacing="8">
								<!-- ratio -->
								<!--<StackPanel Orientation="Horizontal"
											Spacing="8">
									<Button Theme="{StaticResource IconButton}"
											Content="{StaticResource icon-aspect-ratio}"
											VerticalAlignment="Center"
											Command="{x:Static local:MediaPlayerView.AspectRatioCmd}"/>
									<TextBlock Text="{TemplateBinding AspectRatio}"
											   VerticalAlignment="Center"
											   Margin="-8,0,0,0"/>
								</StackPanel>-->

								<!-- speed -->
								<Button Theme="{StaticResource IconButton}"
										Width="68"
										VerticalAlignment="Center"
										Command="{x:Static local:MediaPlayerView.SpeedCmd}">
									<TextBlock Foreground="{TemplateBinding Foreground}"
											   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Speed, StringFormat='X{0:N0}'}"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"
											   FontSize="17"
											   FontWeight="SemiBold"
											   TextAlignment="Center"/>
								</Button>

								<!-- volume -->
								<Button Theme="{StaticResource IconButton}"
										VerticalAlignment="Center"
										x:Name="volume_button">
									<materialIcons:MaterialIcon Kind="VolumeHigh" Width="26" Height="26"/>
								</Button>
								<Popup IsOpen="{TemplateBinding IsVolumePanelVisible}"
									   PlacementTarget="{Binding #volume_button}"
									   Placement="Top"
									   HorizontalOffset="-26"
									   VerticalOffset="-10"
									   IsLightDismissEnabled="False">
									<Border Width="104"
											Height="224"
											CornerRadius="{DynamicResource ManituxRadiusMedium}"
											Background="{DynamicResource ManituxSurfaceBrush}"
											BorderBrush="{DynamicResource ManituxGlassStrokeBrush}"
											BorderThickness="1"
											BoxShadow="0 18 44 0 #88000000"
											Padding="14">
										<Grid RowDefinitions="Auto,*,Auto">
											<TextBlock Grid.Row="0"
													   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=VolumePercent}"
													   Foreground="{DynamicResource ManituxTextBrush}"
													   FontSize="18"
													   FontWeight="SemiBold"
													   HorizontalAlignment="Center"
													   TextWrapping="NoWrap"/>
											<Slider Grid.Row="1"
													Classes="volume-slider"
													Focusable="False"
													Orientation="Vertical"
													HorizontalAlignment="Center"
													VerticalAlignment="Stretch"
													Margin="0,10"
													Maximum="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MaxVolume}"
													Minimum="0"
													Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Volume, Converter={x:Static converter:AutoValueConverters.Instance}, Mode=TwoWay}"/>
											<materialIcons:MaterialIcon Grid.Row="2"
																		Kind="VolumeHigh"
																		Width="24"
																		Height="24"
																		Foreground="{DynamicResource ManituxAccentBrush}"
																		HorizontalAlignment="Center"/>
										</Grid>
									</Border>
								</Popup>

								<!-- subtitles -->
								<Button Theme="{StaticResource IconButton}"
										VerticalAlignment="Center"
										IsVisible="{TemplateBinding HasSubTitles}"
										x:Name="subtitle_button">
									<materialIcons:MaterialIcon Kind="Subtitles" Width="26" Height="26"/>
								</Button>

								<!-- audio tracks -->
								<Button Theme="{StaticResource IconButton}"
										VerticalAlignment="Center"
										IsVisible="{TemplateBinding HasAudioTracks}"
										x:Name="audio_button">
									<materialIcons:MaterialIcon Kind="MusicNote" Width="26" Height="26"/>
								</Button>

								<!-- fullscreen -->
								<Button Theme="{StaticResource IconButton}"
										VerticalAlignment="Center"
										Command="{x:Static local:MediaPlayerView.FullScreenCmd}"
										x:Name="fullscreen_button">
									<Grid>
										<materialIcons:MaterialIcon x:Name="fullscreen_icon" Kind="Fullscreen" Width="26" Height="26"/>
										<materialIcons:MaterialIcon x:Name="fullscreen_exit_icon" Kind="FullscreenExit" Width="26" Height="26" IsVisible="False"/>
									</Grid>
								</Button>

								<!-- file picker -->
								<!--<Button Theme="{StaticResource IconButton}"
										Content="{StaticResource icon-file-video}"
										Command="{x:Static local:MediaPlayerView.OpenFileCmd}"
										VerticalAlignment="Center"
										IsEnabled="True"/>-->
							</StackPanel>

							<!-- seek -->
							<Grid ColumnDefinitions="112,*,112"
								  ColumnSpacing="12"
								  Margin="4,0,4,0"
								  VerticalAlignment="Center">
								<TextBlock Grid.Column="0"
										   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Time, StringFormat='{}{0:hh\\:mm\\:ss}'}"
										   Foreground="{TemplateBinding Foreground}"
										   FontSize="20"
										   FontWeight="SemiBold"
										   TextAlignment="Right"
										   VerticalAlignment="Center"
										   TextWrapping="NoWrap"/>
								<Slider Grid.Column="1"
										VerticalAlignment="Center"
										Classes="seek-active"
										Focusable="True"
										Maximum="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Duration, Converter={x:Static converter:AutoValueConverters.Instance}}"
										Minimum="0"
										Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Time, Converter={x:Static converter:AutoValueConverters.Instance}, Mode=TwoWay}"
										x:Name="PART_TimeBar"/>
								<TextBlock Grid.Column="2"
										   Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=RemainingTime, StringFormat='-{0:hh\\:mm\\:ss}'}"
										   Foreground="{TemplateBinding Foreground}"
										   FontSize="20"
										   FontWeight="SemiBold"
										   TextAlignment="Left"
										   VerticalAlignment="Center"
										   TextWrapping="NoWrap"/>
							</Grid>
						</DockPanel>
					</Border>
				</Grid>
			</ControlTemplate>
		</Setter>
		<Style Selector="^[Playing=True]">
			<Style Selector="^ /template/ materialIcons|MaterialIcon#play_icon">
				<Setter Property="IsVisible" Value="False"/>
			</Style>
			<Style Selector="^ /template/ materialIcons|MaterialIcon#pause_icon">
				<Setter Property="IsVisible" Value="True"/>
			</Style>
		</Style>
		<Style Selector="^[IsFullScreen=True]">
			<Style Selector="^ /template/ materialIcons|MaterialIcon#fullscreen_icon">
				<Setter Property="IsVisible" Value="False"/>
			</Style>
			<Style Selector="^ /template/ materialIcons|MaterialIcon#fullscreen_exit_icon">
				<Setter Property="IsVisible" Value="True"/>
			</Style>
		</Style>
		<Style Selector="^[IsAudioPanelVisible=True]">
			<Style Selector="^ /template/ Button#audio_button /template/ ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}"/>
				<Setter Property="BorderThickness" Value="3"/>
				<Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 7 #882D9CFF"/>
			</Style>
		</Style>
		<Style Selector="^[IsSubtitlePanelVisible=True]">
			<Style Selector="^ /template/ Button#subtitle_button /template/ ContentPresenter">
				<Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}"/>
				<Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}"/>
				<Setter Property="BorderThickness" Value="3"/>
				<Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 7 #882D9CFF"/>
			</Style>
		</Style>
	</ControlTheme>
</ResourceDictionary>
