<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Add Resources Here -->
	<ControlTheme TargetType="Button" x:Key="IconButton" BasedOn="{StaticResource {x:Type Button}}">
		<Setter Property="Width" Value="52"/>
		<Setter Property="Height" Value="52"/>
		<Setter Property="MinWidth" Value="{DynamicResource ManituxRemoteTargetMin}"/>
		<Setter Property="MinHeight" Value="{DynamicResource ManituxRemoteTargetMin}"/>
		<Setter Property="Padding" Value="8"/>
		<Setter Property="CornerRadius" Value="{DynamicResource ManituxRadiusSmall}"/>
		<Setter Property="Foreground" Value="{DynamicResource ManituxTextBrush}"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="FocusAdorner" Value="{x:Null}"/>
	
		<Style Selector="^:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ManituxSurfaceMutedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ManituxAccentBrush}"/>
		</Style>
		<Style Selector="^:focus /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 7 #882D9CFF"/>
		</Style>
		<Style Selector="^:focus-visible /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource ManituxSurfaceRaisedBrush}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}"/>
			<Setter Property="BorderThickness" Value="3"/>
			<Setter Property="BoxShadow" Value="0 0 0 3 #66FFFFFF, 0 0 0 7 #882D9CFF"/>
		</Style>
		<Style Selector="^:disabled /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="^:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="#552D9CFF"/>
			<Setter Property="BorderBrush" Value="{DynamicResource ManituxFocusBrush}"/>
		</Style>
	</ControlTheme>

	<ControlTheme TargetType="ToggleButton" x:Key="IconToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
		<Setter Property="FontFamily" Value="{StaticResource remixicon}"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="FontSize" Value="30"/>
		
		<Style Selector="^:pointerover /template/ ContentPresenter">
			<Setter Property="Foreground">
				<SolidColorBrush Color="White" Opacity="0.8"/>
			</Setter>
		</Style>
		<Style Selector="^:disabled /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="^:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<Style Selector="^:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</ControlTheme>
</ResourceDictionary>
